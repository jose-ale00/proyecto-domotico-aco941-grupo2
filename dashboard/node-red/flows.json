  {
    "id": "d_fS",
    "type": "function",
    "z": "tabUI",
    "name": "Repartir sensores",
    "func": "const p = msg.payload;\nif (!p || p.valor === undefined) return null;\nconst s = msg.topic.split('/').pop();\nconst v = Number(p.valor);\nconst idx = {temperatura: 0, humedad: 1, luminosidad: 2, gas: 3, distancia: 4, movimiento: 5}[s];\nif (idx === undefined || isNaN(v)) return null;\nconst out = [null, null, null, null, null, null, null];\nif (idx === 4) out[4] = {payload: v.toFixed(1) + ' cm'};\nelse if (idx === 5) out[5] = {payload: v ? 'Detectado' : 'Sin movimiento'};\nelse out[idx] = {payload: v};\nif (s === 'temperatura' || s === 'humedad') {\n  out[6] = {topic: s === 'temperatura' ? 'Temperatura (°C)' : 'Humedad (%)', payload: v};\n}\nreturn out;",
    "outputs": 7,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 200,
    "wires": [
