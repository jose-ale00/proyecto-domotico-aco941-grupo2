  {
    "id": "fnE",
    "type": "function",
    "z": "tabP4",
    "name": "Preparar estado",
    "func": "const act = msg.topic.split('/').pop();\nconst est = msg.payload && msg.payload.estado ? String(msg.payload.estado).toUpperCase() : null;\nif (!est) return null;\nconst e = global.get('estados') || {};\ne[act] = est;\nglobal.set('estados', e);\nmsg.params = [act, est];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 300,
    "wires": [
      [
        "pgE"
      ]
    ]
  },
