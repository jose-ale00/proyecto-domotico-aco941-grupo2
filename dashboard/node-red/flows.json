  {
    "id": "fnC",
    "type": "function",
    "z": "tabP4",
    "name": "Armar comando",
    "func": "// Entrada: msg.actuador (ventilador|luz|puerta|alarma) y msg.comando (ON|OFF)\nconst act = msg.actuador;\nconst cmd = String(msg.comando || '').toUpperCase();\nif (!['ventilador','luz','puerta','alarma'].includes(act) || !['ON','OFF'].includes(cmd)) {\n  node.warn('Comando inválido: ' + act + ' / ' + cmd);\n  return null;\n}\nconst base = (global.get('config') || {}).base;\nconst out = {\n  topic: base + '/actuadores/' + act,\n  payload: JSON.stringify({dispositivo: 'casa1', actuador: act, comando: cmd})\n};\nconst log = {params: [act, cmd]};\nreturn [out, log];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 460,
    "wires": [
