  {
    "id": "fnL",
    "type": "function",
    "z": "tabP4",
    "name": "Preparar lectura",
    "func": "const p = msg.payload;\nif (!p || p.valor === undefined) return null;\nconst sensor = msg.topic.split('/').pop();\nconst valor = Number(p.valor);\nif (isNaN(valor)) return null;\n\n// Última lectura en memoria (la usará el dashboard)\nconst ult = global.get('ultimas') || {};\nult[sensor] = {valor: valor, unidad: p.unidad || '', ts: Date.now()};\nglobal.set('ultimas', ult);\n\n// La fecha se guarda con la hora del servidor (now()), no la del ESP32\nmsg.sensor = sensor;\nmsg.valor = valor;\nmsg.params = [p.dispositivo || 'casa1', sensor, valor, p.unidad || ''];\nreturn [msg, RED.util.cloneMessage(msg)];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 160,
    "wires": [
      [
        "pgL"
      ],
      [
        "fnA"
      ]
    ]
  },
  {
    "id": "pgL",
    "type": "postgresql",
    "z": "tabP4",
    "name": "INSERT lecturas",
    "query": "INSERT INTO lecturas (dispositivo, sensor, valor, unidad) VALUES ($1, $2, $3, $4)",
    "postgreSQLConfig": "pgc1",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 620,
    "y": 140,
    "wires": [
      []
    ]
  },
  {
    "id": "fnA",
    "type": "function",
    "z": "tabP4",
    "name": "Evaluar alarmas",
    "func": "const u = global.get('umbrales') || {};\nconst s = msg.sensor, v = msg.valor;\nlet r = null;\nif (s === 'temperatura' && v > u.temperatura_max) r = {tipo: 'Temperatura alta', umbral: u.temperatura_max};\nif (s === 'humedad'     && v < u.humedad_min)     r = {tipo: 'Humedad baja',     umbral: u.humedad_min};\nif (s === 'gas'         && v > u.gas_max)         r = {tipo: 'Gas elevado',      umbral: u.gas_max};\n\nconst act = global.get('alarmasActivas') || {};\nact[s] = !!r;\nglobal.set('alarmasActivas', act);\nif (!r) return null;\n\n// Anti-repetición: una alarma por sensor cada 60 s\nconst cd = context.get('cd') || {};\nconst now = Date.now();\nif (cd[s] && now - cd[s] < 60000) return null;\ncd[s] = now;\ncontext.set('cd', cd);\n\nmsg.params = [r.tipo, s, v, r.umbral, r.tipo + ': ' + v + ' (umbral ' + r.umbral + ')'];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 200,
    "wires": [
      [
        "pgA"
      ]
    ]
  },
  {
    "id": "pgA",
    "type": "postgresql",
    "z": "tabP4",
    "name": "INSERT alarmas",
    "query": "INSERT INTO alarmas (tipo, sensor, valor, umbral, mensaje) VALUES ($1, $2, $3, $4, $5)",
    "postgreSQLConfig": "pgc1",
    "split": false,
    "rowsPerMsg": 1,
    "outputs": 1,
    "x": 840,
