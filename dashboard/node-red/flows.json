  {
    "id": "fnInit",
    "type": "function",
    "z": "tabP4",
    "name": "Configuración y umbrales",
    "func": "global.set('config', {base: 'aco941/PREFIJO_EQUIPO'});\nglobal.set('umbrales', {temperatura_max: 30, humedad_min: 30, gas_max: 600});\nglobal.set('ultimas', {});\nglobal.set('estados', {});\nglobal.set('alarmasActivas', {});\nnode.status({text: 'configuración cargada'});\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
