    "id": "pgE",
    "type": "postgresql",
    "z": "tabP4",
    "name": "UPSERT estado_actuadores",
    "query": "INSERT INTO estado_actuadores (actuador, estado) VALUES ($1, $2) ON CONFLICT (actuador) DO UPDATE SET estado = EXCLUDED.estado, actualizado = now()",
